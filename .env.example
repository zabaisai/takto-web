# =====================================================================
# TAKTO · web comercial — variables de entorno
# ---------------------------------------------------------------------
# Copia este archivo a `.env.local` para desarrollo.
# NUNCA subas un `.env` real al repositorio.
# Ningún secreto puede llevar el prefijo NEXT_PUBLIC_: ese prefijo
# expone el valor en el bundle del navegador.
# =====================================================================

# ---------------------------------------------------------------------
# PÚBLICAS (se incrustan en el cliente — no poner secretos aquí)
# ---------------------------------------------------------------------

# URL canónica del sitio. Sin barra final.
NEXT_PUBLIC_SITE_URL=https://takto.online

# Destino del botón «Ingresar». Acceso funcional al CRM de pruebas, NO identidad
# de marca: por eso conserva el dominio de staging aunque la web sea TAKTO.
NEXT_PUBLIC_CRM_LOGIN_URL=https://crm-staging.tehusrattan.com/login

# Destino del botón «Activar mi empresa». El onboarding exige código de
# invitación, así que la web lo aclara y no lo presenta como registro libre.
NEXT_PUBLIC_CRM_ONBOARDING_URL=https://crm-staging.tehusrattan.com/onboarding

# Pon "false" en preview/staging para emitir `noindex` y bloquear robots.
NEXT_PUBLIC_ALLOW_INDEXING=true

# ---------------------------------------------------------------------
# PRIVADAS (solo servidor)
# ---------------------------------------------------------------------

# Destino de las solicitudes de demostración. PENDIENTE DE APROBACIÓN.
#   log   → (por defecto) registra la solicitud en los logs del servidor sin
#           datos personales completos. No envía correo ni almacena nada.
#   smtp  → envía un correo mediante SMTP (opción A)
#   crm   → publica en un endpoint del CRM (opción B)
#   forms → reenvía a un servicio externo de formularios (opción C)
DEMO_LEAD_SINK=log

# Correo comercial que recibe las solicitudes. PENDIENTE DE CONFIRMAR.
DEMO_LEAD_TO=

# --- Opción A · SMTP (solo si DEMO_LEAD_SINK=smtp) ---
# Requiere añadir un cliente SMTP como dependencia. Aún no instalado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Opción B · endpoint del CRM (solo si DEMO_LEAD_SINK=crm) ---
# Requiere autorización explícita antes de escribir en sistemas del CRM.
CRM_LEADS_ENDPOINT=
CRM_LEADS_TOKEN=

# --- Opción C · servicio externo de formularios (solo si DEMO_LEAD_SINK=forms) ---
FORMS_ENDPOINT=
FORMS_TOKEN=

# ---------------------------------------------------------------------
# Rate limiting del formulario (opcional; hay valores por defecto)
# ---------------------------------------------------------------------
DEMO_RATE_LIMIT_MAX=5
DEMO_RATE_LIMIT_WINDOW_MS=600000
